-module(nerf_test).
-compile([no_auto_import, nowarn_unused_vars, nowarn_unused_function, nowarn_nomatch]).

-export([main/0, nerf_tes/0]).

-spec main() -> nil.
main() ->
    gleeunit:main().

-spec nerf_tes() -> nil.
nerf_tes() ->
    _assert_subject = nerf@websocket:connect(
        <<"192.168.0.204"/utf8>>,
        <<"/api/websocket"/utf8>>,
        8123,
        []
    ),
    {ok, Conn} = case _assert_subject of
        {ok, _} -> _assert_subject;
        _assert_fail ->
            erlang:error(#{gleam_error => let_assert,
                        message => <<"Assertion pattern match failed"/utf8>>,
                        value => _assert_fail,
                        module => <<"nerf_test"/utf8>>,
                        function => <<"nerf_tes"/utf8>>,
                        line => 12})
    end,
    gleam@io:debug(Conn),
    nerf@websocket:send(Conn, <<"Hello"/utf8>>).
